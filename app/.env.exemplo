# Copie este arquivo para .env.teste e para .env.producao e preencha cada um.
# Sem VITE_API_URL o app roda como protótipo, com dados fictícios.

# Endereço da API publicada no Apps Script (termina em /exec).
VITE_API_URL=https://script.google.com/macros/s/COLE_AQUI_O_ID_DA_IMPLANTACAO/exec

# ID do cliente OAuth do site (botão "Fazer login com o Google"). Vazio = só login com senha.
VITE_GOOGLE_CLIENT_ID=

# Áreas ligadas nesta fase, separadas por vírgula. Vazio = todas (só para o protótipo).
VITE_RECURSOS=pessoas,dadosPessoais,mural,formularios,configuracoes,eventos,escalas,escalasPessoais,pagamentos,almoxEstoque,almoxSaidas,infraestrutura,relatar,contratos,busca
